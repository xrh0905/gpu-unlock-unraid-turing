#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-only
# gpu-turing-unlock control script.
#
#   start     install the packages for the running kernel and load turing_unlock (plugin install / boot)
#   apply     settings form: settings only change what the next boot does
#   firmware  build the pinned NVIDIA 610.43.03 firmware package locally
#   stop      unload the module (an unlocked card stays unlocked until it loses power)
#   status    plain-text status for the settings page
#
# turing_unlock only acts on cards no driver has claimed and must run before nvidia binds them.
# On Unraid that is the nvidia-driver plugin, which rc.local installs after this plugin because
# "gpu-turing-unlock.plg" sorts before "nvidia-driver.plg". The module package also ships an
# /etc/rc.d/rc.modules-<kernel> hook, which Unraid runs even earlier; this script is the fallback.

PLG=gpu-turing-unlock
CFGDIR=/boot/config/plugins/$PLG
CFG=$CFGDIR/$PLG.cfg
DEFCFG=/usr/local/emhttp/plugins/$PLG/default.cfg
PKGROOT=$CFGDIR/packages
FWBUILD=/usr/local/emhttp/plugins/$PLG/firmware/build-firmware.sh
KR=$(uname -r)
MAJOR=${KR%%-*}
PKGDB=/var/lib/pkgtools/packages
[ -d "$PKGDB" ] || PKGDB=/var/log/packages
KO=/lib/modules/$KR/extra/turing_unlock.ko
NV=610.43.03
# TU102/TU104/TU106 IDs from kernel/turing_unlock/main.c; only TU102 is tested upstream.
SUPPORTED_IDS=" 1e03 1e04 1e07 1e2d 1e2e 1e81 1e82 1e84 1e87 1e89 1ec2 1ec7 1f02 1f03 1f06 1f07 1f08 1f42 1f47 "

log() { logger -t gpu-turing-unlock -- "$*" 2>/dev/null; echo "$*"; }
notify() { /usr/local/emhttp/webGui/scripts/notify -e "Turing Unlock" -s "$1" -d "$2" -i "${3:-normal}" -l "/Settings/GPUUnlock" >/dev/null 2>&1; }

cfg() {
  local v
  v=$(grep -E "^$1=" "$CFG" 2>/dev/null | tail -1 | cut -d= -f2- | tr -d '"\r')
  [ -z "$v" ] && v=$(grep -E "^$1=" "$DEFCFG" 2>/dev/null | tail -1 | cut -d= -f2- | tr -d '"\r')
  echo "$v"
}
ENABLED=$(cfg ENABLED); TARGETS=$(cfg TARGETS)
TARGETS=$(echo "$TARGETS" | tr -d ' ' | tr 'A-F' 'a-f')
[ -z "$TARGETS" ] && TARGETS=all
targets_valid() { [ "$TARGETS" = all ] || [[ $TARGETS =~ ^[0-9a-f]{4}:[0-9a-f]{2}:[0-9a-f]{2}\.[0-9a-f](,[0-9a-f]{4}:[0-9a-f]{2}:[0-9a-f]{2}\.[0-9a-f])*$ ]]; }

loaded() { [ -d /sys/module/turing_unlock ]; }
module_pkg() { ls -1 "$PKGROOT/$MAJOR"/turing-unlock-module-*-"$KR"-*.txz 2>/dev/null | sort -V | tail -1; }
firmware_pkg() { ls -1 "$PKGROOT/firmware"/turing-unlock-firmware-*.txz 2>/dev/null | sort -V | tail -1; }
pkg_installed() { [ -e "$PKGDB/$(basename "$1" .txz)" ]; }
pkg_verify() {
  [ -f "$1.sha256" ] || return 0
  ( cd "$(dirname "$1")" && sha256sum -c --quiet "$(basename "$1").sha256" >/dev/null 2>&1 )
}
firmware_ok() {
  local f
  for f in $(modinfo -F firmware "$KO" 2>/dev/null); do
    [ -f "/lib/firmware/$f" ] || return 1
  done
  return 0
}

# "<bdf> <device-id> <driver|none>" for supported cards
cards() {
  local d v id drv
  for d in /sys/bus/pci/devices/*; do
    v=$(cat "$d/vendor" 2>/dev/null); [ "$v" = 0x10de ] || continue
    id=$(cat "$d/device" 2>/dev/null); id=${id#0x}
    [[ $SUPPORTED_IDS == *" $id "* ]] || continue
    if [ -e "$d/driver" ]; then drv=$(basename "$(readlink -f "$d/driver")"); else drv=none; fi
    echo "$(basename "$d") $id $drv"
  done
}
target_cards() {
  if [ "$TARGETS" = all ]; then cards; else cards | grep -E "^(${TARGETS//,/|}) " || true; fi
}

write_rtd3() {
  local f
  for f in /etc/modprobe.d/zz-turing-unlock.conf /boot/config/modprobe.d/zz-turing-unlock.conf; do
    [ -f "$f" ] && continue
    printf '%s\n' '# Written by gpu-turing-unlock. The unlock is volatile; D3cold clears it.' \
      'options nvidia NVreg_DynamicPowerManagement=0x00' > "$f" 2>/dev/null || true
  done
}

install_pkgs() {
  local modpkg fwpkg p rc=0
  modpkg=$(module_pkg); fwpkg=$(firmware_pkg)
  if [ -z "$modpkg" ]; then
    log "no turing-unlock module package for kernel $KR in $PKGROOT/$MAJOR"
    notify "No module for kernel $KR" "No turing-unlock-module-*-$KR-*.txz in $PKGROOT/$MAJOR. The cards stay at the stock FP16 rate. Re-run the release build for this Unraid version." warning
    return 1
  fi
  for p in "$fwpkg" "$modpkg"; do
    [ -n "$p" ] || continue
    if ! pkg_verify "$p"; then
      log "checksum mismatch: $p"
      notify "Package checksum mismatch" "$(basename "$p") does not match its .sha256 file. Download the plugin package again." alert
      rc=1; continue
    fi
    if ! pkg_installed "$p"; then
      log "installing $(basename "$p")"
      upgradepkg --install-new "$p" >/dev/null || { log "installpkg failed for $p"; rc=1; continue; }
    fi
  done
  depmod -a "$KR" 2>/dev/null
  [ -f "$KO" ] || { log "$KO missing after install"; rc=1; }
  if [ -f "$KO" ] && [ "$(modinfo -F vermagic "$KO" 2>/dev/null | cut -d' ' -f1)" != "$KR" ]; then
    log "module vermagic does not match $KR"; rc=1
  fi
  return $rc
}

new_dmesg() { dmesg 2>/dev/null | grep -F turing_unlock | tail -n +"$(( $1 + 1 ))"; }

start() {
  if [ "$ENABLED" != yes ]; then log "disabled in settings, nothing loaded"; return 0; fi
  if ! targets_valid; then
    log "invalid Targets setting '$TARGETS' (use 'all' or comma-separated PCI addresses like 0000:3b:00.0)"
    notify "Invalid Targets setting" "'$TARGETS' is not 'all' or a comma-separated list of PCI addresses. Nothing was unlocked." warning
    return 0
  fi
  write_rtd3
  install_pkgs || return 0
  if loaded; then log "turing_unlock already loaded"; return 0; fi
  if ! firmware_ok; then
    log "firmware package for $NV is not installed"
    notify "Firmware package missing" "The $NV firmware is not installed. Open Settings - User Utilities - Turing Unlock and click 'Build firmware package', then reboot." warning
    return 0
  fi
  if [ -z "$(target_cards)" ]; then
    log "no supported Turing card matches targets=$TARGETS; not loading"
    return 0
  fi
  if lsmod | grep -q '^nvidia ' || target_cards | grep -q ' nvidia$'; then
    log "nvidia is already loaded; turing_unlock must run before it. Packages are installed; the unlock runs at the next boot."
    notify "Reboot to unlock" "turing-unlock is installed, but the nvidia driver is already bound. The unlock runs at the next boot, before the nvidia-driver plugin loads nvidia." normal
    return 0
  fi
  if target_cards | grep -q ' vfio-pci$'; then
    log "a target card is bound to vfio-pci; it is left untouched (the unlock would be cleared by the VM's FLR)"
  fi
  local before ok=0
  before=$(dmesg 2>/dev/null | grep -cF turing_unlock)
  log "loading turing_unlock targets=$TARGETS"
  modprobe turing_unlock targets="$TARGETS" && ok=1 || log "modprobe turing_unlock failed ($?)"
  local lines unlocked failed
  lines=$(new_dmesg "$before")
  [ -n "$lines" ] && echo "$lines" | while read -r l; do log "$l"; done
  unlocked=$(echo "$lines" | grep -c 'turing_unlock: unlocked$')
  failed=$(echo "$lines" | grep -c 'unlock failed\|firmware.*failed\|no supported card')
  if [ "$ok" = 1 ] && [ "$unlocked" -gt 0 ] && [ "$failed" -eq 0 ]; then
    notify "Unlocked $unlocked card(s)" "turing_unlock unlocked $unlocked card(s) before the nvidia driver." normal
  elif [ "$ok" = 1 ] && [ "$unlocked" -gt 0 ]; then
    notify "Unlocked $unlocked card(s), $failed problem(s)" "Some cards were not unlocked. See Settings - User Utilities - Turing Unlock." warning
  else
    notify "Unlock did not happen" "turing_unlock loaded but unlocked nothing (or failed to load). See Settings - User Utilities - Turing Unlock and the system log." warning
  fi
  return 0
}

firmware() {
  local fwpkg=""
  fwpkg=$(firmware_pkg)
  if [ -n "$fwpkg" ] && [ -s "$fwpkg" ]; then
    log "firmware package already present: $fwpkg"
  else
    command -v python3 >/dev/null 2>&1 || { notify "Cannot build firmware" "python3 is missing on this Unraid install." alert; return 1; }
    command -v zstd >/dev/null 2>&1 || { notify "Cannot build firmware" "zstd is missing on this Unraid install." alert; return 1; }
    [ -x "$FWBUILD" ] || { notify "Cannot build firmware" "$FWBUILD is missing; reinstall the plugin." alert; return 1; }
    log "building the pinned $NV firmware package; this downloads ~500 MB and can take several minutes"
    mkdir -p "$PKGROOT/firmware"
    local work=${TURING_UNLOCK_WORKDIR:-/var/tmp/turing-unlock-firmware.$$}
    if ! "$FWBUILD" "$PKGROOT/firmware" "$work"; then
      rm -rf "$work"
      notify "Firmware build failed" "See the output on Settings - User Utilities - Turing Unlock. The cards stay at the stock FP16 rate." alert
      return 1
    fi
    rm -rf "$work"
    fwpkg=$(firmware_pkg)
  fi
  [ -n "$fwpkg" ] || { notify "Firmware build failed" "No package was produced." alert; return 1; }
  if ! pkg_installed "$fwpkg"; then
    pkg_verify "$fwpkg" || { notify "Firmware checksum mismatch" "$(basename "$fwpkg") failed its .sha256 check." alert; return 1; }
    upgradepkg --install-new "$fwpkg" >/dev/null || { notify "Firmware install failed" "$(basename "$fwpkg") did not install." alert; return 1; }
  fi
  log "firmware ready: $fwpkg"
  if loaded; then
    log "the module is already loaded; the unlock keeps running until the next reboot"
  else
    log "reboot to load turing_unlock before nvidia"
    notify "Firmware ready; reboot" "The $NV firmware is installed. Reboot to unlock the card before the nvidia driver binds it." normal
  fi
  return 0
}

apply() {
  log "settings saved: enabled=$ENABLED targets=$TARGETS"
  if loaded; then
    log "module is loaded; settings take effect at the next boot (the unlock can only run before nvidia binds the card)"
  else
    start
  fi
}

stop() {
  if loaded; then rmmod turing_unlock && log "turing_unlock unloaded (an unlocked card stays unlocked until it loses power)"; fi
}

status() {
  local modpkg fwpkg
  modpkg=$(module_pkg); fwpkg=$(firmware_pkg)
  echo "kernel:   $KR"
  echo "settings: enabled=$ENABLED targets=$TARGETS"
  if [ -n "$modpkg" ]; then echo "module package:   $(basename "$modpkg") $(pkg_installed "$modpkg" && echo '(installed)' || echo '(not installed)')"; else echo "module package:   NONE for $KR in $PKGROOT/$MAJOR"; fi
  if [ -n "$fwpkg" ]; then echo "firmware package: $(basename "$fwpkg") $(pkg_installed "$fwpkg" && echo '(installed)' || echo '(not installed)')"; else echo "firmware package: NONE in $PKGROOT/firmware (use 'Build firmware package')"; fi
  [ -f "$PKGROOT/$MAJOR/BUILD-INFO" ] && sed 's/^/  /' "$PKGROOT/$MAJOR/BUILD-INFO"
  if loaded; then
    echo "module:   loaded (version $(cat /sys/module/turing_unlock/version 2>/dev/null), targets=$(cat /sys/module/turing_unlock/parameters/targets 2>/dev/null))"
  elif [ -f "$KO" ]; then
    echo "module:   installed for $KR, not loaded"
  else
    echo "module:   not installed"
  fi
  echo "nvidia:   $(lsmod | grep -q '^nvidia ' && echo loaded || echo 'not loaded')"
  local rt
  rt=$(grep -h 'DynamicPowerManagement' /etc/modprobe.d/zz-turing-unlock.conf /boot/config/modprobe.d/zz-turing-unlock.conf 2>/dev/null | head -1 || true)
  echo "rtd3:     ${rt:-not configured}"
  echo "cards (Turing GeForce):"
  local any=0 bdf id drv last
  while read -r bdf id drv; do
    any=1
    last=$(dmesg 2>/dev/null | grep -F "$bdf: turing_unlock:" | tail -1 | sed 's/^.*turing_unlock: //')
    printf '  %s  10de:%s  driver=%-9s %s\n' "$bdf" "$id" "$drv" "${last:+[$last]}"
  done < <(cards)
  [ "$any" = 0 ] && echo "  none found"
  echo "recent turing_unlock kernel messages:"
  dmesg 2>/dev/null | grep -F turing_unlock | tail -25 | sed 's/^/  /'
  [ "$(dmesg 2>/dev/null | grep -cF turing_unlock)" = 0 ] && echo "  (none since boot)"
  return 0
}

case "$1" in
  start) start ;;
  apply) apply ;;
  firmware) firmware ;;
  stop) stop ;;
  status) status ;;
  *) echo "usage: $0 {start|apply|firmware|stop|status}"; exit 1 ;;
esac
